CREATE TABLE discovery_suggestions (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    media_type TEXT NOT NULL,
    row_type TEXT NOT NULL,
    title TEXT NOT NULL,
    clean_title TEXT NOT NULL,
    cover_url TEXT,
    reason TEXT,
    seed_title TEXT,
    provider TEXT NOT NULL,
    score REAL NOT NULL DEFAULT 0,
    position INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL,
    source_id INTEGER,
    source_url TEXT,
    genres TEXT
);

CREATE INDEX discovery_media_row ON discovery_suggestions(media_type, row_type);

selectAllByMedia:
SELECT * FROM discovery_suggestions
WHERE media_type = ?
ORDER BY position ASC, id ASC;

deleteByMediaAndRow:
DELETE FROM discovery_suggestions
WHERE media_type = ? AND row_type = ?;

insert:
INSERT INTO discovery_suggestions(media_type, row_type, title, clean_title, cover_url, reason, seed_title, provider, score, position, created_at, source_id, source_url, genres)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

lastUpdatedAt:
SELECT IFNULL(MAX(created_at), 0) FROM discovery_suggestions
WHERE media_type = ?;

-- Backfill после апгрейда: SOURCE-строки кэша до миграции 58 без привязки (source_id NULL).
countUnboundSourceRows:
SELECT COUNT(*) FROM discovery_suggestions
WHERE row_type = 'source' AND source_id IS NULL;
