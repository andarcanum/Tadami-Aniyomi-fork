CREATE TABLE discovery_signals (
    media_type TEXT NOT NULL,
    clean_title TEXT NOT NULL,
    title TEXT NOT NULL,
    signal TEXT NOT NULL,
    weight REAL NOT NULL,
    genres TEXT,
    provider TEXT,
    source_key TEXT,
    created_at INTEGER NOT NULL,
    primary_clean_title TEXT NOT NULL DEFAULT '',
    identity_key TEXT,
    source_id INTEGER,
    source_url TEXT,
    trusted_aliases TEXT,
    metadata_changed_at INTEGER NOT NULL DEFAULT 0,
    positive_signal TEXT,
    positive_created_at INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (media_type, clean_title)
);

CREATE INDEX discovery_signals_time ON discovery_signals(media_type, created_at);

selectAllByMedia:
SELECT * FROM discovery_signals WHERE media_type = ? ORDER BY created_at ASC;

selectByTitle:
SELECT * FROM discovery_signals WHERE media_type = ? AND clean_title = ?;

selectByAnyKey:
SELECT * FROM discovery_signals
WHERE media_type = :mediaType
  AND (
    clean_title = :cleanTitle
    OR (:identityKey != '' AND identity_key = :identityKey)
    OR (:primaryCleanTitle != '' AND primary_clean_title = :primaryCleanTitle)
  )
ORDER BY CASE WHEN identity_key IS NOT NULL AND identity_key != '' THEN 0 ELSE 1 END, created_at DESC;

upsert:
INSERT INTO discovery_signals(
    media_type, clean_title, title, signal, weight, genres, provider, source_key, created_at,
    primary_clean_title, identity_key, source_id, source_url, trusted_aliases, metadata_changed_at,
    positive_signal, positive_created_at
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(media_type, clean_title) DO UPDATE SET
    title = excluded.title,
    signal = excluded.signal,
    weight = excluded.weight,
    genres = excluded.genres,
    provider = excluded.provider,
    source_key = excluded.source_key,
    created_at = excluded.created_at,
    primary_clean_title = excluded.primary_clean_title,
    identity_key = COALESCE(excluded.identity_key, discovery_signals.identity_key),
    source_id = COALESCE(excluded.source_id, discovery_signals.source_id),
    source_url = COALESCE(excluded.source_url, discovery_signals.source_url),
    trusted_aliases = CASE
        WHEN excluded.trusted_aliases IS NULL OR excluded.trusted_aliases = '' THEN discovery_signals.trusted_aliases
        ELSE excluded.trusted_aliases
    END,
    metadata_changed_at = MAX(discovery_signals.metadata_changed_at, excluded.metadata_changed_at),
    positive_signal = COALESCE(excluded.positive_signal, discovery_signals.positive_signal),
    positive_created_at = MAX(discovery_signals.positive_created_at, excluded.positive_created_at);

delete:
DELETE FROM discovery_signals WHERE media_type = ? AND clean_title = ?;

deleteByAnyKey:
DELETE FROM discovery_signals
WHERE media_type = :mediaType
  AND (
    clean_title = :cleanTitle
    OR (:identityKey != '' AND identity_key = :identityKey)
    OR (:primaryCleanTitle != '' AND primary_clean_title = :primaryCleanTitle)
  );

deleteHideByTitle:
DELETE FROM discovery_signals
WHERE media_type = ? AND clean_title = ? AND signal = 'hide';

deleteAllByMedia:
DELETE FROM discovery_signals WHERE media_type = ?;

deleteAll:
DELETE FROM discovery_signals;

deleteTasteVotesByMedia:
DELETE FROM discovery_signals
WHERE media_type = ?
  AND signal NOT IN ('consumed', 'consumed_liked', 'consumed_added');

downgradeConsumedTasteByMedia:
UPDATE discovery_signals
SET signal = 'consumed',
    weight = 0.0,
    genres = NULL,
    provider = NULL,
    source_key = NULL,
    positive_signal = NULL,
    positive_created_at = 0
WHERE media_type = ?
  AND signal IN ('consumed_liked', 'consumed_added');

downgradeConsumedToPositive:
UPDATE discovery_signals
SET signal = ?,
    weight = ?,
    created_at = positive_created_at
WHERE media_type = ? AND clean_title = ?;

countByMedia:
SELECT COUNT(*) FROM discovery_signals WHERE media_type = ?;

countLiveByMedia:
SELECT COUNT(*)
FROM discovery_signals
WHERE media_type = ?
  AND signal NOT IN ('consumed', 'consumed_liked', 'consumed_added');

selectConsumedByMedia:
SELECT * FROM discovery_signals WHERE media_type = ? AND signal IN ('consumed', 'consumed_liked', 'consumed_added') ORDER BY created_at ASC;

countConsumedByMedia:
SELECT COUNT(*) FROM discovery_signals
WHERE media_type = ? AND signal IN ('consumed', 'consumed_liked', 'consumed_added');

evictOldestLive:
DELETE FROM discovery_signals WHERE media_type = ? AND clean_title IN (
    SELECT clean_title FROM discovery_signals
    WHERE media_type = ? AND signal NOT IN ('consumed', 'consumed_liked', 'consumed_added')
    ORDER BY created_at ASC, clean_title ASC LIMIT ?
);

evictOldestConsumed:
DELETE FROM discovery_signals WHERE media_type = ? AND clean_title IN (
    SELECT clean_title FROM discovery_signals
    WHERE media_type = ? AND signal IN ('consumed', 'consumed_liked', 'consumed_added')
    ORDER BY created_at ASC, clean_title ASC LIMIT ?
);

updateMetadataIfMatchesCreatedAt:
UPDATE discovery_signals
SET
    genres = ?,
    provider = ?,
    source_key = ?,
    trusted_aliases = ?,
    source_id = ?,
    source_url = ?,
    identity_key = ?,
    metadata_changed_at = ?
WHERE media_type = ?
  AND clean_title = ?
  AND positive_created_at = ?
  AND positive_signal IS NOT NULL;
