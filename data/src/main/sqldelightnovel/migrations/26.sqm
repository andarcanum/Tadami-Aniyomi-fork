-- Highlights & Notes: user-selected text ranges anchored to (chapter, block, char offsets).
CREATE TABLE novel_highlights (
    _id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    novel_id INTEGER NOT NULL,
    chapter_id INTEGER NOT NULL,
    block_index INTEGER NOT NULL DEFAULT 0,
    char_start INTEGER NOT NULL DEFAULT 0,
    char_end_exclusive INTEGER NOT NULL DEFAULT 0,
    normalized_text TEXT NOT NULL DEFAULT '',
    color_argb INTEGER NOT NULL DEFAULT 4294688813,
    note TEXT NOT NULL DEFAULT '',
    created_at INTEGER NOT NULL DEFAULT 0,
    updated_at INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY(novel_id) REFERENCES novels(_id) ON DELETE CASCADE
);

CREATE INDEX novel_highlights_novel_id_index ON novel_highlights(novel_id);
CREATE INDEX novel_highlights_chapter_id_index ON novel_highlights(chapter_id);
