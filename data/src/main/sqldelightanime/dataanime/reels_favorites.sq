import java.util.Date;

CREATE TABLE reels_favorites(
    video_id TEXT NOT NULL,
    source_id INTEGER NOT NULL,
    title TEXT,
    author TEXT,
    video_url TEXT NOT NULL,
    video_url_hd TEXT,
    poster_url TEXT NOT NULL,
    poster_url_vertical TEXT,
    web_url TEXT,
    duration_sec REAL,
    has_audio INTEGER NOT NULL,
    added_at INTEGER AS Date NOT NULL,
    PRIMARY KEY (video_id, source_id)
);

CREATE INDEX reels_favorites_added_at_index ON reels_favorites(added_at DESC);

-- getBySource/getIdsBySource filter on source_id; without this index every favorites
-- load is a full table scan (the composite PK cannot serve source_id-only lookups).
CREATE INDEX reels_favorites_source_id_index ON reels_favorites(source_id);

getAll:
SELECT *
FROM reels_favorites
ORDER BY added_at DESC;

getBySource:
SELECT *
FROM reels_favorites
WHERE source_id = :sourceId
ORDER BY added_at DESC;

getIdsBySource:
SELECT video_id
FROM reels_favorites
WHERE source_id = :sourceId;

insert:
INSERT OR REPLACE INTO reels_favorites(
    video_id, source_id, title, author, video_url, video_url_hd,
    poster_url, poster_url_vertical, web_url, duration_sec, has_audio, added_at
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

delete:
DELETE FROM reels_favorites
WHERE video_id = :videoId AND source_id = :sourceId;
